{
  "schemaVersion": 1,
  "id": "firemio.posty-simple-robo",
  "name": "シンプルロボ（3D）",
  "version": "1.0.0",
  "author": "firemio",
  "description": "旧ふわふわ3Dのポスティ。まるっとしたシンプルなブリキロボ",
  "license": "MIT",
  "behaviorProfile": "posty",
  "renderer": "gltf-3d",
  "thumbnail": "thumbnail.webp",
  "source": {
    "type": "model",
    "file": "assets/character.glb",
    "scale": 1,
    "groundOffset": 0,
    "rotationY": 0,
    "motions": {
      "idle": {
        "clip": "idle"
      },
      "look-around": {
        "clip": "look-around"
      },
      "alert": {
        "clip": "alert"
      },
      "bounce": {
        "clip": "bounce"
      },
      "self-care": {
        "clip": "self-care"
      },
      "rest": {
        "clip": "rest"
      },
      "inspect": {
        "clip": "inspect"
      },
      "celebrate": {
        "clip": "celebrate"
      },
      "walk": {
        "clip": "idle"
      },
      "deliver": {
        "clip": "bounce"
      }
    }
  }
}
