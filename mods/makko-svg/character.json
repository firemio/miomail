{
  "schemaVersion": 1,
  "id": "firemio.makko-svg",
  "name": "マクコ（SVG）",
  "version": "1.0.0",
  "author": "firemio",
  "description": "組み込みのマクコをDOM/SVG MODとして再構成した同梱キャラクター",
  "license": "MIT",
  "behaviorProfile": "makko",
  "renderer": "dom-svg",
  "source": {
    "type": "scene",
    "file": "scene.json",
    "motions": {
      "idle": {
        "pose": { "rotate": -2 },
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "look-around": {
        "poseAnimation": "pose-look-around",
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "alert": {
        "pose": { "rotate": -6, "translateY": 2, "scaleX": 0.97, "scaleY": 1.04 },
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "bounce": {
        "pose": { "rotate": 1, "translateY": -3, "scaleX": 1.06, "scaleY": 0.96 },
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "self-care": {
        "poseAnimation": "pose-soft-stretch",
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "rest": {
        "poseAnimation": "pose-doze",
        "poseOrigin": [50, 90],
        "expression": "sleepy",
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "inspect": {
        "poseAnimation": "pose-peek",
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "celebrate": {
        "poseAnimation": "pose-hop",
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "walk": {
        "pose": { "rotate": -2, "translateY": -1 },
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      },
      "deliver": {
        "pose": { "rotate": 2, "translateY": -2, "scale": 1.02 },
        "poseOrigin": [50, 90],
        "animations": ["ear-left", "ear-right"],
        "loop": true
      }
    }
  }
}
